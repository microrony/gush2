{% comment %}
  Handpicked Colours + Colour Guide Modal
  Drop-in section for collection page.
  Author: KJ x Gush
{% endcomment %}

<section class="gush-handpicked-wrapper">
  <div class="gush-handpicked">
    <div class="gush-handpicked__copy">
      <h2 class="gush-handpicked__title">
        {{ section.settings.heading | escape }}
      </h2>
      <p class="gush-handpicked__body">
        {{ section.settings.body }}
      </p>
      <button
        id="gush-handpicked-open"
        class="gush-handpicked__btn"
        type="button"
        aria-haspopup="dialog"
        aria-controls="gush-handpicked-overlay"
      >
        {{ section.settings.button_label | escape }}
      </button>
    </div>
  </div>

  <!-- Modal / Overlay -->
  <div
    id="gush-handpicked-overlay"
    class="gush-handpicked-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="Gush E-Commerce Colour Guide"
  >
    <div class="gush-handpicked-overlay__content">
      <button
        class="gush-handpicked-overlay__close"
        type="button"
        aria-label="Close"
      >
        ×
      </button>

      {% assign guide_url = section.settings.guide_url | strip %}
      {% assign is_pdf = guide_url | downcase | slice: -4, 4 %}
      {% if is_pdf == '.pdf' %}
        <iframe
          src="{{ guide_url }}"
          class="gush-handpicked-overlay__frame"
          title="Gush E-Commerce Colour Guide PDF"
        ></iframe>
      {% else %}
        <img
          src="{{ guide_url }}"
          alt="Gush E-Commerce Colour Guide"
          class="gush-handpicked-overlay__image"
          loading="eager"
        >
      {% endif %}
    </div>
  </div>

  <style>
    .gush-handpicked-wrapper {
      background: #FF4B00; /* current orange background */
      color: #1a1a1a;
      padding: clamp(24px, 4vw, 56px) 0;
    }
    .gush-handpicked {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
      display: grid;
      align-items: center;
    }
    .gush-handpicked__title {
      font-size: clamp(28px, 3.2vw, 48px);
      line-height: 1.1;
      margin: 0 0 12px 0;
      color: #111;
    }
    .gush-handpicked__body {
      font-size: clamp(16px, 1.4vw, 18px);
      margin: 0 0 20px 0;
      max-width: 60ch;
      color: #231f20;
    }
    .gush-handpicked__btn {
      background: #FF17A3; /* Gush accent */
      color: #fff;
      border: 0;
      border-radius: 8px;
      padding: 12px 20px;
      font-size: 16px;
      cursor: pointer;
      transition: transform .05s ease, opacity .2s ease;
    }
    .gush-handpicked__btn:active { transform: translateY(1px); }
    .gush-handpicked__btn:hover { opacity: .95; }

    /* Overlay */
    .gush-handpicked-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.65);
      z-index: 9999;
      display: none; /* toggled via JS */
      padding: 24px;
    }
    .gush-handpicked-overlay.is-open { display: block; }
    .gush-handpicked-overlay__content {
      position: relative;
      background: #fff;
      width: min(100%, 980px);
      margin: 4vh auto;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0,0,0,.25);
      overflow: hidden;
    }
    .gush-handpicked-overlay__close {
      position: absolute;
      top: 10px; right: 12px;
      font-size: 28px;
      line-height: 1;
      background: transparent;
      border: 0;
      cursor: pointer;
      color: #111;
    }
    .gush-handpicked-overlay__image {
      display: block;
      width: 100%;
      height: auto;
    }
    .gush-handpicked-overlay__frame {
      display: block;
      width: 100%;
      height: min(80vh, 900px);
      border: 0;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var openBtn = document.getElementById('gush-handpicked-open');
      var overlay = document.getElementById('gush-handpicked-overlay');
      if (!openBtn || !overlay) return;
      var closeBtn = overlay.querySelector('.gush-handpicked-overlay__close');

      function openOverlay() {
        overlay.classList.add('is-open');
        document.documentElement.style.overflow = 'hidden';
        closeBtn && closeBtn.focus();
      }
      function closeOverlay() {
        overlay.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        openBtn && openBtn.focus();
      }

      openBtn.addEventListener('click', openOverlay);
      closeBtn && closeBtn.addEventListener('click', closeOverlay);

      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeOverlay();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
          closeOverlay();
        }
      });
    });
  </script>

  {% schema %}
{
  "name": "Colour Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Here are our handpicked colours"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Finding your shade should feel inspiring, not overwhelming. That’s why we’ve curated 66 handpicked bestsellers and timeless favourites: so choosing the right colour for your home feels effortless.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View the Colour Guide"
    },
    {
      "type": "url",
      "id": "guide_url",
      "label": "Colour Guide file URL (PNG or PDF)",
      "info": "Paste the URL from Content → Files. If it ends in .pdf, it will embed as a PDF. Otherwise it will show an image."
    }
  ],
  "presets": [
    { "name": "Colour Guide" }
  ]
}
{% endschema %}