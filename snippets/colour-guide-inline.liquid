{%- comment -%}
Gush: Colour Guide banner (inline)
- Aligned with grid via .gush-page-width
- Headline + CTA share a row; no body copy
- CTA has subtle one-time pulse
- Overlay: desktop-safe, scrollable, thin header
{%- endcomment -%}

{%- assign GUIDE_URL = "https://cdn.shopify.com/s/files/1/0614/1470/3297/files/Gush_E-Commerce_Colour_Guide.pdf?v=1756040535" -%}

<li class="grid__item"
    style="grid-column:1 / -1 !important; width:100% !important; max-width:100% !important; flex:0 0 100% !important; list-style:none;">

  <style>
    /* --- Banner layout --- */
    .gush-guide-banner { background:#FF4B00; color:#1a1a1a; border-radius:14px; padding:clamp(28px,4vw,56px) 0; margin:24px 0; }
    .gush-guide-container { /* aligns with your grid container */
      max-width: 100%; margin: 0 auto;
    }
    .gush-guide-inner { padding: 0 32px; }              /* side padding inside the orange */
    @media (max-width: 768px){ .gush-guide-inner{ padding: 0 20px; } }

    .gush-guide-top { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; flex-wrap:wrap; }
    .gush-guide-title {
      margin:0;
      font-size:clamp(32px, 5vw, 64px);
      line-height:1.05;
      color:#111;
      flex:1 1 680px; /* lets the title span nicely */
    }

    .gush-guide-btn {
      appearance:none; -webkit-appearance:none;
      background:#FF17A3; color:#fff; font-weight:800;
      border:0; border-radius:12px;
      padding:14px 22px; font-size:16px; line-height:1;
      box-shadow:0 8px 20px rgba(255,23,163,.35);
      transition:transform .06s ease, box-shadow .2s ease, filter .2s ease;
      cursor:pointer; white-space:nowrap; align-self:flex-start;
    }
    .gush-guide-btn:hover { box-shadow:0 12px 28px rgba(255,23,163,.45); filter:saturate(1.05); }
    .gush-guide-btn:active { transform:translateY(1px); }
    .gush-guide-btn:focus { outline:2px solid #111; outline-offset:2px; }

    @media (max-width: 900px) {
      .gush-guide-top { flex-direction:column; align-items:flex-start; }
      .gush-guide-btn { margin-top:10px; }
    }

    /* --- Subtle one-time pulse (respects reduced motion) --- */
    @media (prefers-reduced-motion: no-preference) {
      .gush-guide-btn.is-pulsing { animation: gushPulse 1.2s ease-out 0.4s 2; }
      @keyframes gushPulse {
        0%   { transform: scale(1);    box-shadow: 0 8px 20px rgba(255,23,163,.35); }
        50%  { transform: scale(1.06); box-shadow: 0 18px 36px rgba(255,23,163,.55); }
        100% { transform: scale(1);    box-shadow: 0 8px 20px rgba(255,23,163,.35); }
      }
    }

    /* --- Overlay chrome (thin header) --- */
    #gush-guide-overlay { position:fixed; inset:0; background:rgba(0,0,0,.65); z-index:2147483647; display:none; padding:2vh 2vw; }
    #gush-guide-modal {
      position:relative; background:#fff; width:min(96vw,1280px); margin:2vh auto; border-radius:12px;
      box-shadow:0 10px 30px rgba(0,0,0,.25); display:flex; flex-direction:column; max-height:96vh;
    }
    .gush-guide-modal__hdr {
      display:flex; align-items:center; justify-content:flex-end;
      height:44px; padding:0 12px; border-bottom:1px solid #e9e9e9; flex:0 0 auto;
    }
    #gush-guide-close {
      width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center;
      font-size:20px; line-height:1; background:transparent; border:0; color:#111; cursor:pointer;
    }
    .gush-guide-modal__body { flex:1 1 auto; min-height:0; overflow:auto; }
    .gush-guide-modal__body object, .gush-guide-modal__body iframe { width:100%; height:100% !important; min-height:80vh; display:block; border:0; }
    .gush-guide-modal__ftr { padding:8px 12px; text-align:center; flex:0 0 auto; border-top:1px solid #f1f1f1; }
  </style>

  <div class="gush-guide-banner">
    <!-- use your site container so it aligns perfectly with the grid -->
    <div class="gush-page-width gush-guide-container">
      <div class="gush-guide-inner">
        <div class="gush-guide-top">
          <h2 class="gush-guide-title">All Our Listed Colours At One Glance</h2>
          <button type="button" id="gush-guide-open" class="gush-guide-btn" aria-haspopup="dialog" aria-controls="gush-guide-overlay">
            View the Colour Guide
          </button>
        </div>
        {# body text removed per request #}
      </div>
    </div>
  </div>

  <!-- Overlay (moved to <body> by JS) -->
  <div id="gush-guide-overlay" role="dialog" aria-modal="true" aria-label="Gush E-Commerce Colour Guide">
    <div id="gush-guide-modal">
      <div class="gush-guide-modal__hdr">
        <button type="button" id="gush-guide-close" aria-label="Close">×</button>
      </div>
      <div class="gush-guide-modal__body">
        <object data="{{ GUIDE_URL }}" type="application/pdf" aria-label="Gush E-Commerce Colour Guide">
          <iframe src="{{ GUIDE_URL }}" title="Gush E-Commerce Colour Guide"></iframe>
        </object>
      </div>
      <div class="gush-guide-modal__ftr">
        <a href="{{ GUIDE_URL }}" target="_blank" rel="noopener" style="text-decoration:underline;">
          Open the Colour Guide in a new tab
        </a>
      </div>
    </div>
  </div>
</li>

<script>
(function(){
  var openBtn  = document.getElementById('gush-guide-open');
  var overlay  = document.getElementById('gush-guide-overlay');
  var closeBtn = document.getElementById('gush-guide-close');

  if (!openBtn || !overlay || !closeBtn) return;

  // Ensure overlay lives at <body> level (avoids clipping/stack issues)
  if (overlay.parentNode !== document.body) document.body.appendChild(overlay);

  function lockScroll(lock){
    var root = document.documentElement, body = document.body;
    if (lock) { root.style.overflow = 'hidden'; body.style.overflow = 'hidden'; }
    else { root.style.overflow = ''; body.style.overflow = ''; }
  }

  function openOverlay(){ overlay.style.display = 'block'; lockScroll(true); try{ closeBtn.focus(); }catch(e){} }
  function closeOverlay(){ overlay.style.display = 'none';  lockScroll(false); try{ openBtn.focus(); }catch(e){} }

  openBtn.addEventListener('click', openOverlay);
  closeBtn.addEventListener('click', closeOverlay);
  overlay.addEventListener('click', function(e){ if (e.target === overlay) closeOverlay(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && overlay.style.display === 'block') closeOverlay(); });

  // Subtle one-time CTA pulse when banner first enters the viewport
  (function(){
    try {
      var seenKey = 'gushGuidePulseSeen';
      if (sessionStorage.getItem(seenKey) === '1') return;
      function runPulse(){ openBtn.classList.add('is-pulsing'); sessionStorage.setItem(seenKey, '1');
        openBtn.addEventListener('animationend', function(){ openBtn.classList.remove('is-pulsing'); }, { once:true }); }
      if ('IntersectionObserver' in window) {
        var banner = document.querySelector('.gush-guide-banner');
        if (banner) {
          var io = new IntersectionObserver(function(entries){
            entries.forEach(function(entry){ if(entry.isIntersecting){ runPulse(); io.disconnect(); } });
          }, { threshold: 0.5 });
          io.observe(banner);
        } else { setTimeout(runPulse, 800); }
      } else { setTimeout(runPulse, 800); }
    } catch(e){}
  })();
})();
</script>