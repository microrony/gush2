{%- comment -%}
Gush: Handpicked colours banner (inline)
- Full-bleed banner (edge-to-edge across viewport)
- Still behaves as a grid item so rows of 3 stay intact
- Desktop-safe overlay (moved to <body>)
- Taller modal (90vh) + robust PDF embed
{%- endcomment -%}

{%- assign GUIDE_URL = "https://cdn.shopify.com/s/files/1/0614/1470/3297/files/Gush_E-Commerce_Colour_Guide.pdf?v=1756040535" -%}

<li class="grid__item"
    style="
      grid-column: 1 / -1 !important;
      width: 100% !important;
      max-width: 100% !important;
      flex: 0 0 100% !important;
      list-style: none;
    ">

  {%- comment -%} FULL-BLEED WRAPPER {%- endcomment -%}
  <div
    style="
      background:#FF4B00;
      color:#1a1a1a;
      padding: clamp(28px, 4vw, 64px) 0;
      margin: 24px 0;
      /* full-bleed trick */
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    "
  >
    <div style="max-width:1320px;margin:0 auto;padding:0 24px;">
      <h2 style="font-size:clamp(26px,3.2vw,44px);line-height:1.15;margin:0 0 14px;color:#111;">
        Here are our handpicked colours
      </h2>
      <p style="font-size:clamp(15px,1.3vw,19px);max-width:65ch;margin:0 0 22px;color:#231f20;">
        Finding your shade should feel inspiring, not overwhelming. That’s why we’ve curated 66 handpicked bestsellers and timeless favourites: so choosing the right colour for your home feels effortless.
      </p>
      <button type="button" id="gush-guide-open"
              style="background:#FF17A3;color:#fff;border:0;border-radius:10px;padding:12px 22px;font-size:16px;cursor:pointer;">
        View the Colour Guide
      </button>
    </div>
  </div>

  <!-- Overlay (moved to <body> by JS) -->
  <div id="gush-guide-overlay"
       role="dialog" aria-modal="true" aria-label="Gush E-Commerce Colour Guide"
       style="position:fixed;inset:0;background:rgba(0,0,0,.65);
              z-index:2147483647;display:none;padding:24px;">
    <div id="gush-guide-modal"
         style="position:relative;background:#fff;width:min(96vw,1280px);
                margin:3vh auto;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.25);
                overflow:hidden;min-height:90vh;display:flex;flex-direction:column;">
      <button type="button" id="gush-guide-close" aria-label="Close"
              style="position:absolute;top:12px;right:16px;font-size:28px;line-height:1;
                     background:transparent;border:0;cursor:pointer;color:#111;">×</button>

      <div style="flex:1 1 auto;height:auto;min-height:0;">
        <object data="{{ GUIDE_URL }}" type="application/pdf"
                style="display:block;width:100%;height:100% !important;min-height:75vh;"
                aria-label="Gush E-Commerce Colour Guide">
          <!-- Fallback if <object> is blocked -->
          <iframe src="{{ GUIDE_URL }}" title="Gush E-Commerce Colour Guide"
                  style="display:block;width:100%;height:100% !important;border:0;"></iframe>
        </object>
      </div>

      <div style="padding:10px 16px;text-align:center;flex:0 0 auto;">
        <a href="{{ GUIDE_URL }}" target="_blank" rel="noopener"
           style="text-decoration:underline;">Open the Colour Guide in a new tab</a>
      </div>
    </div>
  </div>
</li>

<script>
(function(){
  var openBtn  = document.getElementById('gush-guide-open');
  var overlay  = document.getElementById('gush-guide-overlay');
  var closeBtn = document.getElementById('gush-guide-close');

  if (!openBtn || !overlay || !closeBtn) return;

  // Ensure overlay lives at <body> level (avoids clipping/stacking issues on desktop)
  if (overlay.parentNode !== document.body) {
    document.body.appendChild(overlay);
  }

  function lockScroll(lock){
    var root = document.documentElement, body = document.body;
    if (lock) { root.style.overflow = 'hidden'; body.style.overflow = 'hidden'; }
    else { root.style.overflow = ''; body.style.overflow = ''; }
  }

  function openOverlay(){ overlay.style.display = 'block'; lockScroll(true); try { closeBtn.focus(); } catch(e){} }
  function closeOverlay(){ overlay.style.display = 'none';  lockScroll(false); try { openBtn.focus(); } catch(e){} }

  openBtn.addEventListener('click', openOverlay);
  closeBtn.addEventListener('click', closeOverlay);
  overlay.addEventListener('click', function(e){ if (e.target === overlay) closeOverlay(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && overlay.style.display === 'block') closeOverlay(); });
})();
</script>